# Comma separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173
# Local dev server port. Ignored on Vercel.
PORT=3000
# Postgres connection string (the pooled Neon URL). Leave unset to serve the catalogue from seed.json.
# The Vercel Neon integration names it KANG_TEA_DB_DATABASE_URL; the api accepts either name.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
