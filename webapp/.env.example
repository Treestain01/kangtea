# Base URL of the api project. No trailing slash.
VITE_API_URL=http://localhost:3000
# Simulated kitchen: seconds after placing until making, and until ready. Defaults 20 and 60.
# Put low values in webapp/.env.local (git ignored) to test the order flow without waiting.
# VITE_KITCHEN_MAKING_SECONDS=2
# VITE_KITCHEN_READY_SECONDS=5
